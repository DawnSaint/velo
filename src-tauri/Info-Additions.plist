<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Finder 右键「服务」菜单注册 ——「在 Velo 中打开」文件夹动词。

  本文件只含增量 NSServices 数组，Tauri 通过 bundle.macOS.infoPlist 把它合并进
  默认 Info.plist（docs.rs MacConfig::info_plist: "merge with the default"）。

  NSMessage = openInVelo: 指定 Finder 选中「服务 → 在 Velo 中打开」时调用的方法名，
  finder_service.rs 用 objc crate 向 service provider 注册该方法实现。
  NSSendTypes 限定只对文件夹生效（public.folder + public.file-or-folder）。
-->
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMessage</key>
			<string>openInVelo:</string>
			<key>NSPortName</key>
			<string>Velo</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>在 Velo 中打开</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>public.folder</string>
				<string>public.file-or-folder</string>
			</array>
			<key>NSTimeout</key>
			<string>30000</string>
		</dict>
	</array>
</dict>
</plist>
