{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/2.x/tooling/cli/schema.json",
  "productName": "Velo",
  "version": "0.5.0",
  "identifier": "com.velo.editor",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: filesystem: https: http://asset.localhost asset: 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; img-src 'self' data: blob: https: http://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "app", "dmg", "msi"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "description": "Markdown 文档"
      }
    ],
    "windows": {
      "wix": { "language": "zh-CN" }
    }
  },
  "plugins": {}
}
