{
  "name": "velo",
  "private": true,
  "version": "0.7.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --build --force && vite build && node scripts/clean-katex.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug --no-bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "clean:dev": "node scripts/clean-dev-cache.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,mjs,cjs,scss}\" \"e2e/**/*.{ts}\" \"scripts/**/*.{mjs,cjs,js}\" \"*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,mjs,cjs,scss}\" \"e2e/**/*.{ts}\" \"scripts/**/*.{mjs,cjs,js}\" \"*.{ts,js,mjs}\"",
    "lint:console": "node scripts/lint-console.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:design-tokens:baseline": "node scripts/lint-design-tokens.mjs --baseline",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "bench:corpus": "node scripts/gen-large-file-corpus.mjs",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lucide/vue": "^1.31.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.10",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "node-emoji": "^2.2.0",
    "pinia": "^4.0.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.7",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.41.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@wdio/cli": "^9.29.0",
    "@wdio/local-runner": "^9.29.0",
    "@wdio/mocha-framework": "^9.29.0",
    "@wdio/spec-reporter": "^9.29.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.2",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.0"
  }
}
