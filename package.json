    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "katex": "^0.16.21",
    "mermaid": "^11.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "sass": "^1.83.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.0",
